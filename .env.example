# Listen only on loopback. Reach the Pi through the documented SSH tunnel or
# a local HTTPS reverse proxy such as Tailscale Serve; never expose plain HTTP.
HOST=127.0.0.1
PORT=8787
DASHBOARD_ACCESS_PIN=

# OpenJarvis and Ollama stay local on the Raspberry Pi.
OPENJARVIS_BASE_URL=http://127.0.0.1:8000
OPENJARVIS_API_KEY=
# Bound the OpenJarvis handoff so a stalled agent falls back to local Ollama.
# Keep this above the normal Pi response time, but below the 180-second model cap.
OPENJARVIS_CHAT_TIMEOUT_MS=45000
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Bound the whole local model cascade so a stalled runner advances to the next
# installed specialist/primary model instead of holding the voice session.
OLLAMA_CHAT_TIMEOUT_MS=45000
# Mixed printer/weather/Google requests use a shorter synthesis budget so a
# CPU-only Pi reaches the deterministic evidence fallback quickly.
MULTI_PURPOSE_OLLAMA_TIMEOUT_MS=18000
# Structured JSON lanes (email drafts and Office artifacts) use a shorter
# total budget and fall back to a deterministic local plan when it expires.
OLLAMA_STRUCTURED_TIMEOUT_MS=30000
# Keep Ollama local-only and disable cloud features on Pi/Linux/Windows.
# On Linux, install-pi.sh also writes these values into the systemd drop-in.
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_NO_CLOUD=1
# Keep one model resident at a time so the Pi 5 can swap the general and vision
# roles without exhausting RAM.
OLLAMA_MAX_LOADED_MODELS=1
ALLOW_OLLAMA_FALLBACK=true

# Curated keyless public-information tools. These are not API credentials.
# Override the defaults only when a different location/country is preferred.
PUBLIC_API_DEFAULT_LOCATION=Dubai
PUBLIC_API_DEFAULT_COUNTRY=AE
PUBLIC_API_TIMEOUT_MS=8000
# Identifying User-Agent for OpenStreetMap/Nominatim requests. Keep requests
# light; the public instance is limited to roughly one request per second.
PUBLIC_API_USER_AGENT=JARVIS-Private-Web-Tool/1.0
# Open-Meteo is the default and needs no key. These are optional fallbacks;
# leave blank to stay fully keyless.
PUBLIC_API_WEATHER_PROVIDER=open-meteo
OPENWEATHERMAP_API_KEY=
WEATHERAPI_API_KEY=

# Browser tools are enabled by scripts/setup-openjarvis-pi.sh. OpenJarvis runs
# as the separate jarvis-agent account, never the dashboard owner. Host control
# is confined to /srv/jarvis-workspace and has no sudo, Docker socket, OAuth,
# dashboard .env, SSH key, or private-home access.
JARVIS_ENABLE_HOST_CONTROL=false
OPENJARVIS_INSTALL_DIR=/opt/openjarvis
OPENJARVIS_WORKSPACE=/srv/jarvis-workspace

# JARVIS uses Camoufox only for both direct `open <website>` navigation and
# approved browser-agent tasks; it never uses your normal personal browser
# profile. Interactive clicks and typing still require a one-task approval in
# the dashboard. Install the paired build with `npx camoufox fetch` (the Pi
# installer does this for the isolated agent).
JARVIS_BROWSER_CONTROL_ENABLED=true
JARVIS_BROWSER_ENGINE=camoufox
JARVIS_BROWSER_PROFILE=
JARVIS_BROWSER_OUTPUT=
# An explicit public `open <website>` also gets one short-lived, read-only
# screenshot in the private workspace. It uses a fresh context with no cookies;
# continuous display sharing still needs the visible SHARE YOUR SCREEN action.
JARVIS_BROWSER_PREVIEW_ENABLED=true
JARVIS_BROWSER_PREVIEW_TIMEOUT_MS=12000

# Generated PPTX, DOCX, and XLSX files stay in this private workspace. Leave
# blank to use data/artifacts inside the command center.
JARVIS_ARTIFACT_DIR=

# Optional server-side Stirling PDF processing. The key is sent only as the
# X-API-KEY header from this Node service; it is never returned to the browser,
# model, logs, or GitHub. Stirling Cloud uses https://api.stirling.com by
# default. A self-hosted Stirling URL may be used without a key.
STIRLING_URL=https://api.stirling.com
STIRLING_API_KEY=
# Only PDFs inside these roots may be uploaded. Use a semicolon-delimited list
# on Windows and a colon-delimited list on Linux; blank uses JARVIS_ARTIFACT_DIR
# or data/artifacts.
STIRLING_INPUT_ROOTS=
STIRLING_TIMEOUT_MS=60000
STIRLING_MAX_INPUT_BYTES=26214400

# Optional local vision model for user-approved screen snapshots. The live
# display stream stays in the browser; only an explicit ANALYZE SNAPSHOT click
# sends one compressed frame to this local Ollama model.
# Recommended Pi 5 balance: run `./install-pi.sh --vision`. It chooses
# qwen2.5vl:3b (~3.2 GB) on a normal 8 GB Pi and moondream:1.8b (~1.7 GB)
# on constrained RAM/storage. To force a tag, set it explicitly before install:
# JARVIS_VISION_MODEL=qwen2.5vl:3b
JARVIS_VISION_MODEL=

# Private Google OAuth files. Defaults are auto-discovered at
# ~/jarvis-google/ and ~/Documents/Jarvis-Google-Auth/. Override only when the
# files live elsewhere. Never copy their contents into this file or GitHub.
GOOGLE_CREDENTIALS_PATH=
GOOGLE_TOKEN_PATH=
# Optional for a web OAuth client with an explicitly registered loopback redirect.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8789/
# Drafting is always available and sends nothing. Set this true only after the
# OAuth token has been re-authorized with https://www.googleapis.com/auth/gmail.send.
# Every send still requires the visible draft, operations PIN, and SEND EMAIL.
GOOGLE_EMAIL_SEND_ENABLED=false

# Fixed Moonraker/Fluidd endpoint for the Creality/Klipper printer.
# The browser cannot override this URL or send arbitrary G-code.
PRINTER_URL=http://192.168.4.74:4408
PRINTER_API_KEY=
PRINTER_TIMEOUT_MS=2800
# Optional read-only printer webcam snapshot endpoint. It must use the same
# host as PRINTER_URL (for example a webcamd snapshot path on the printer LAN).
PRINTER_CAMERA_URL=
PRINTER_CAMERA_TIMEOUT_MS=8000
PRINTER_CAMERA_DISCOVERY_TIMEOUT_MS=1800
PRINTER_CAMERA_MAX_BYTES=8388608

# Optional local OBS WebSocket v5 bridge. Keep this loopback-only; the bridge
# reads scenes, sources, stream/record/replay/virtual-camera state, studio preview,
# and mixer values. It requires the
# dashboard PIN plus an exact confirmation phrase for every mutating action.
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=
OBS_TIMEOUT_MS=2500
# Optional stable token for the read-only OBS browser-source overlay. If blank,
# JARVIS creates an ignored data/.obs-overlay-token on first start.
OBS_OVERLAY_TOKEN=

# Optional path-delimited roots for the private file galaxy. If blank, only
# this command-center project is indexed. File contents and secret paths are excluded.
KNOWLEDGE_ROOTS=

# The installer generates a private 6-digit value when this is blank.
# It is required for restart/maintenance/self-repair controls.
OPS_CONTROL_PIN=
OPS_HELPER_PATH=/usr/local/sbin/jarvis-service-control
AUTO_REPAIR_ENABLED=true

# Pi-only fully local Hey Jarvis + double-clap listener.
# install-pi.sh configures these after installing openWakeWord.
ENABLE_PI_WAKE_LISTENER=true
WAKE_PYTHON=/home/pi5/openjarvis-pi-command-center/.wake-venv/bin/python
# Physical microphone gate for Pi wake accuracy. The model score and these
# real-audio checks must both pass before JARVIS wakes.
PI_WAKE_ENERGY_FLOOR=0.0035
PI_WAKE_NOISE_MULTIPLIER=1.6
PI_WAKE_PEAK_FLOOR=0.004
PI_WAKE_PEAK_RATIO=1.12
# Optional fully local Pi command transcription. Install Vosk and an English
# small model with `install-pi.sh --stt`, then point this at that model folder.
# The wake listener remains wake-only when this is blank.
JARVIS_STT_MODEL_DIR=
JARVIS_STT_MODEL_URL=https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip
JARVIS_STT_COMMAND_TIMEOUT_MS=15000
JARVIS_STT_COMMAND_SILENCE_MS=900
# Ignore the wake phrase and the spoken "Yes sir" tail before arming Vosk.
JARVIS_STT_COMMAND_WARMUP_MS=1200

# One local model powers every automatic specialist role by default.
# Optional specialist overrides let JARVIS auto-switch to a downloaded model for
# a task while falling back to JARVIS_MODEL when that model is not installed.
# Keep only as many models loaded as the Pi can handle; one small model is the
# safest default on a 16 GB Raspberry Pi.
JARVIS_MODEL=llama3.2:1b
# GENERAL_MODEL=
# CODING_MODEL=
# REASONING_MODEL=
# MONITOR_MODEL=
# MEMORY_MODEL=
# FABRICATOR_MODEL=
# CONNECTOR_MODEL=
# BROADCAST_MODEL=
# MEDIA_MODEL=
# SOCIAL_MODEL=

# Voice mode: fish uses the cloud API; local uses the browser/Pi system voice.
# These values are fake examples supplied for testing. Replace the key with a
# real secret only in .env on the Pi. Never commit .env.
TTS_MODE=fish
# Keep voice identity stable. If Fish is unavailable, show an error instead of
# silently switching to an unrelated Windows/Linux browser voice.
ALLOW_BROWSER_TTS_FALLBACK=false
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=612b878b113047d9a770c069c8b4fdfe
FISH_AUDIO_MODEL=s2.1-pro-free
# Refined, measured delivery. Use latency=normal for the best voice quality.
FISH_AUDIO_SPEED=0.92
FISH_AUDIO_TEMPERATURE=0.30
FISH_AUDIO_TOP_P=0.55
FISH_AUDIO_VOLUME=0
FISH_AUDIO_LATENCY=normal
FISH_AUDIO_TIMEOUT_MS=30000
